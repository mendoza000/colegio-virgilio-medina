---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="flex flex-col gap-1">
  <p class="font-display text-xs uppercase tracking-[0.32em] text-green">Panel</p>
  <h1 class="font-body text-3xl font-bold text-ink">{title}</h1>
  {subtitle ? <p class="text-sm text-ink-muted">{subtitle}</p> : null}
</div>
