---
import Layout from "../../layouts/Layout.astro";
import AdminShell from "../../components/admin/AdminShell";
import AdminDashboardGrid from "../../components/admin/AdminDashboardGrid";

export const prerender = false;
---

<Layout title="Panel administrativo — Admin C.V.M." description="Panel administrativo del Colegio Virgilio Medina.">
  <AdminShell client:load>
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-8">
      <div class="flex flex-col gap-1">
        <p class="font-display text-xs uppercase tracking-[0.32em] text-green">Panel</p>
        <h1 class="font-body text-3xl font-bold text-ink">Bienvenido</h1>
        <p class="text-sm text-ink-muted">Elegí una sección para editar el contenido del sitio.</p>
      </div>

      <AdminDashboardGrid client:load />
    </div>
  </AdminShell>
</Layout>
