---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero";
import About from "../components/About";
import Stats from "../components/Stats";
import AcademicLevels from "../components/AcademicLevels";
import Schedules from "../components/Schedules";
import Subjects from "../components/Subjects";
import Enrollment from "../components/Enrollment";
import Gallery from "../components/Gallery";
import Testimonials from "../components/Testimonials";
import Contact from "../components/Contact";
import Footer from "../components/Footer";
import {
  getSiteSettings,
  getSocialLinks,
  getSectionHeadings,
  getAboutContent,
  getAboutValues,
  getAcademicLevels,
  getSubjectsByLevel,
  getScheduleRows,
  getExtracurricularActivities,
  getEnrollmentSteps,
  getEnrollmentSettings,
  getGalleryImages,
} from "../lib/content";

const [
  settings,
  socialLinks,
  headings,
  about,
  aboutValues,
  academicLevels,
  subjectsByLevel,
  scheduleRows,
  extracurricularActivities,
  enrollmentSteps,
  enrollmentSettings,
  galleryPhotos,
] = await Promise.all([
  getSiteSettings(),
  getSocialLinks(),
  getSectionHeadings(),
  getAboutContent(),
  getAboutValues(),
  getAcademicLevels(),
  getSubjectsByLevel(),
  getScheduleRows(),
  getExtracurricularActivities(),
  getEnrollmentSteps(),
  getEnrollmentSettings(),
  getGalleryImages(),
]);
---

<Layout>
  <Navbar client:load settings={settings} socialLinks={socialLinks} />

  <Hero client:load slogan={settings.slogan} />

  <About
    client:visible
    heading={headings.about}
    mission={about.mission}
    vision={about.vision}
    imageUrl={about.image_url}
    values={aboutValues}
  />

  <Stats client:visible />

  <AcademicLevels client:visible heading={headings.academic_levels} levels={academicLevels} />

  <Schedules
    client:visible
    heading={headings.schedules}
    rows={scheduleRows}
    activities={extracurricularActivities}
  />

  <Subjects
    client:visible
    heading={headings.subjects}
    levels={academicLevels}
    subjectsByLevel={subjectsByLevel}
  />

  <Enrollment
    client:visible
    heading={headings.enrollment}
    steps={enrollmentSteps}
    schoolYearBadge={enrollmentSettings.school_year_badge}
    formPdfUrl={enrollmentSettings.form_pdf_url}
  />

  <Gallery client:visible heading={headings.gallery} photos={galleryPhotos} />

  <Testimonials client:visible />

  <Contact client:visible settings={settings} heading={headings.contact} socialLinks={socialLinks} />

  <Footer settings={settings} socialLinks={socialLinks} />
</Layout>
